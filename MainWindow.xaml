<Window x:Class="PCOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Optimizer PRO v14.0" Width="1280" Height="830" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0EA5E9"/>

        <!-- Interruptor Deslizante (Toggle Switch Estilo Galdino Control) -->
        <Style x:Key="ModernSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="24" Background="Transparent">
                            <Border x:Name="track" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12"/>
                            <Ellipse x:Name="thumb" Width="18" Height="18" Fill="#94A3B8" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="33"/>
            <Setter Property="Margin" Value="10,1,10,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,0">
                            <Grid>
                                <Border x:Name="ind" Width="3.5" Height="16" Background="{DynamicResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left" Margin="-12,0,0,0" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#111827"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#0F1E36"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter TargetName="ind" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBtn" TargetType="Button">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeroBtn" TargetType="Button" BasedOn="{StaticResource CardBtn}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
        </Style>
    </Window.Resources>

    <Border x:Name="mainBorder" Background="#070A10" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR ESQUERDA -->
            <Border Grid.Column="0" Background="#090D16" CornerRadius="12,0,0,12" BorderBrush="#161F30" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="18,16,15,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#0284C7" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                                <TextBlock Text="⚡" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="PC OPTIMIZER" FontSize="15.5" FontWeight="Bold" Foreground="White"/>
                                <TextBlock x:Name="lblVerTitle" Text="CONTROL PRO v14.0" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Margin="10,4,10,10" Padding="8">
                        <StackPanel>
                            <TextBlock Text="⌨️ Hotkeys In-Game:" Foreground="#38BDF8" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Ctrl+Shift+F1: Boost RAM" Foreground="#64748B" FontSize="9.5"/>
                            <TextBlock Text="Ctrl+Shift+F2: Mira | F3: Overlay" Foreground="#64748B" FontSize="9.5"/>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <TextBlock Text="PRINCIPAL" Foreground="#475569" FontSize="9.5" FontWeight="Bold" Margin="20,4,0,2"/>
                        <RadioButton x:Name="nav1" Content="📊  Início / Central" Style="{StaticResource NavBtn}" IsChecked="True"/>
                        <RadioButton x:Name="nav2" Content="🪟  Windows (Switches)" Style="{StaticResource NavBtn}"/>
                        <RadioButton x:Name="nav3" Content="🎮  Aba Jogos (Por Jogo)" Style="{StaticResource NavBtn}"/>
                        <RadioButton x:Name="nav4" Content="🚀  FPS &amp; Latência Pro" Style="{StaticResource NavBtn}"/>
                        <TextBlock Text="FERRAMENTAS &amp; TESTES" Foreground="#475569" FontSize="9.5" FontWeight="Bold" Margin="20,8,0,2"/>
                        <RadioButton x:Name="nav5" Content="🎯  Process Lasso / CPU" Style="{StaticResource NavBtn}"/>
                        <RadioButton x:Name="nav6" Content="十  Mira Ecrã &amp; Ping Jogos" Style="{StaticResource NavBtn}"/>
                        <RadioButton x:Name="nav7" Content="👑  Resolução 4:3 &amp; Gargalo" Style="{StaticResource NavBtn}"/>
                        <RadioButton x:Name="nav8" Content="💿  Caçador de Espaço SSD" Style="{StaticResource NavBtn}"/>
                        <RadioButton x:Name="nav9" Content="📦  App Store Gamer" Style="{StaticResource NavBtn}"/>
                        <RadioButton x:Name="nav10" Content="⚔️  Simulador 30k &amp; Testes" Style="{StaticResource NavBtn}"/>
                        <RadioButton x:Name="nav11" Content="🗑️  Deep Uninstaller (Revo)" Style="{StaticResource NavBtn}"/>
                        <RadioButton x:Name="nav12" Content="❄️  Sensores, Fans &amp; RGB" Style="{StaticResource NavBtn}"/>
                        <RadioButton x:Name="nav13" Content="🎥  Streamer &amp; OBS" Style="{StaticResource NavBtn}"/>
                        <RadioButton x:Name="nav14" Content="⏪  Backups &amp; Reverter" Style="{StaticResource NavBtn}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ÁREA DIREITA -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="135"/>
                </Grid.RowDefinitions>

                <Border x:Name="topDragBar" Grid.Row="0" Background="#090D16" CornerRadius="0,12,0,0" BorderBrush="#161F30" BorderThickness="0,0,0,1" Padding="22,8">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="lblHardware" Text="Olá! A carregar sensores térmicos LibreHardwareMonitor..." Foreground="White" FontSize="13.5" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <CheckBox x:Name="chkGuard" Content="🛡️ Auto-Guard RAM (&lt;2.5GB)" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,15,0" VerticalContentAlignment="Center" Cursor="Hand"/>
                                <CheckBox x:Name="chkTimer" Content="⚡ Timer 0.5ms Ativo" Foreground="#34D399" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,15,0" VerticalContentAlignment="Center" Cursor="Hand"/>
                                <Button x:Name="btnOverlay" Content="🎯 Overlay (F3)" Background="#1E293B" Foreground="#E2E8F0" BorderThickness="0" Padding="9,2" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="0,0,6,0"/>
                                <Button x:Name="btnTopCrosshair" Content="十 Mira (F2)" Background="#1E293B" Foreground="#E2E8F0" BorderThickness="0" Padding="9,2" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="0,0,6,0"/>
                                <Button x:Name="btnUpdate" Content="🔄 Procurar Update" Background="#0284C7" Foreground="White" BorderThickness="0" Padding="9,2" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,4,12,0">
                                <TextBlock x:Name="lblLiveStats" Text="CPU: 0°C | GPU: 0°C | RAM: 0MB" Foreground="#38BDF8" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"/>
                            </Border>
                            <Button x:Name="btnMin" Content="—" Width="30" Height="24" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontSize="12" FontWeight="Bold" Cursor="Hand" Margin="2,0"/>
                            <Button x:Name="btnMax" Content="🗖" Width="30" Height="24" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" FontSize="12" FontWeight="Bold" Cursor="Hand" Margin="2,0"/>
                            <Button x:Name="btnClose" Content="✕" Width="30" Height="24" Background="#E11D48" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="Bold" Cursor="Hand" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="18,10,18,6">
                    <Grid x:Name="page1" Visibility="Visible"/>
                    <Grid x:Name="page2" Visibility="Collapsed"/>
                    <Grid x:Name="page3" Visibility="Collapsed"/>
                    <Grid x:Name="page4" Visibility="Collapsed"/>
                    <Grid x:Name="page5" Visibility="Collapsed"/>
                    <Grid x:Name="page6" Visibility="Collapsed"/>
                    <Grid x:Name="page7" Visibility="Collapsed"/>
                    <Grid x:Name="page8" Visibility="Collapsed"/>
                    <Grid x:Name="page9" Visibility="Collapsed"/>
                    <Grid x:Name="page10" Visibility="Collapsed"/>
                    <Grid x:Name="page11" Visibility="Collapsed"/>
                    <Grid x:Name="page12" Visibility="Collapsed"/>
                    <Grid x:Name="page13" Visibility="Collapsed"/>
                    <Grid x:Name="page14" Visibility="Collapsed"/>
                </Grid>

                <Border Grid.Row="2" Background="#05070B" BorderBrush="#161F30" BorderThickness="1" CornerRadius="8" Margin="18,0,18,12" Padding="10,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="TERMINAL DE ENGENHARIA &amp; AI HARDWARE AUTO-TUNER:" Foreground="#475569" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtLog" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>